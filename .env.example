# Copie como .env.local (desarrollo) o cargue en Vercel → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clave de servicio: SOLO en el servidor. Nunca la publique.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dirección pública de la plataforma (se usa en los enlaces de los mensajes)
APP_URL=https://su-proyecto.vercel.app

HOSPITAL_NAME=Hospital San Pablo de Coquimbo
SOME_PHONE=            # teléfono de SOME para avisar que no podrá asistir
SOME_HOURS=            # ej.: lunes a viernes, 8:00 a 17:00

# Claves largas y aleatorias (32 caracteres o más). Ej.: https://www.random.org/strings/
TOKEN_SECRET=
CRON_SECRET=

# Usuario y contraseña del panel de indicadores (/panel)
PANEL_USER=equipo
PANEL_PASSWORD=

# Envío de mensajes. "simulado" registra los mensajes en el panel sin enviarlos.
NOTIFY_PROVIDER=simulado
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# Correo (Resend). Sin clave, los correos quedan simulados.
RESEND_API_KEY=
EMAIL_FROM=
